@page "/contact"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using Telerik.SvgIcons
@inject NavigationManager Nav
@inject ChopChop.Services.UIService UI

<PageTitle>Contact — ChopChop Landscaping</PageTitle>
<HeadContent>
  <link rel="canonical" href="@Nav.Uri" />
  <meta name="description" content="Contact ChopChop Landscaping. We reply within one business day." />
  <meta property="og:title" content="Contact ChopChop" />
  <meta property="og:description" content="Get in touch for lawn care and landscaping." />
</HeadContent>

<section class="cc-section">
  <h1>We’re here to help</h1>
  <div class="cc-grid-2">
    <div class="card cc-card">
      <div class="cc-card-body">
        <EditForm Model="model" OnValidSubmit="SendAsync">
          <DataAnnotationsValidator />
          <ValidationSummary />
          <div class="field">
            <label>Name</label>
            <TelerikTextBox @bind-Value="model.Name" AutoComplete="name" Width="100%">
              <TextBoxPrefixTemplate>
                <TelerikSvgIcon Icon="@SvgIcon.User" />
              </TextBoxPrefixTemplate>
            </TelerikTextBox>
            <ValidationMessage For="@(() => model.Name)" />
          </div>
          <div class="field">
            <label>Email</label>
      <TelerikTextBox @bind-Value="model.Email" InputMode="email" AutoComplete="email" Width="100%">
              <TextBoxPrefixTemplate>
        <TelerikSvgIcon Icon="@SvgIcon.Envelope" />
              </TextBoxPrefixTemplate>
            </TelerikTextBox>
            <ValidationMessage For="@(() => model.Email)" />
          </div>
          <div class="field">
            <label>Message</label>
            <TelerikTextArea @bind-Value="model.Message" Rows="4" Width="100%">
              <TextAreaPrefixTemplate>
                <TelerikSvgIcon Icon="@SvgIcon.Comment" />
              </TextAreaPrefixTemplate>
            </TelerikTextArea>
            <ValidationMessage For="@(() => model.Message)" />
          </div>
          <div class="cc-card-actions">
            <TelerikButton ButtonType="@ButtonType.Submit"
                           ThemeColor="@Telerik.Blazor.ThemeConstants.Button.ThemeColor.Primary"
                           Icon="@SvgIcon.Envelope">Send Message</TelerikButton>
          </div>
        </EditForm>
      </div>
      <p class="cc-hint">We reply within one business day.</p>
    </div>
    <div class="cc-contact-alt card cc-card">
      <div class="cc-card-body">
        <p><strong>Call:</strong> (555) 014-1234 <span class="cc-subtle">Weekdays 8–6</span></p>
        <p><strong>Email:</strong> hello@chopchop.land</p>
        <p><strong>Address:</strong> 123 Maple St, Springfield</p>
      </div>
    </div>
  </div>
</section>

@code {
  private ContactModel model = new();
  private async Task SendAsync()
  {
    await Task.Delay(300);
    UI.ShowToast("Thanks! We’ll be in touch within one business day.");
    model = new(); // reset form
  }

  public class ContactModel
  {
    [Required] public string Name { get; set; } = "";
    [Required, EmailAddress] public string Email { get; set; } = "";
    [Required, StringLength(1000)] public string Message { get; set; } = "";
  }
}
