@page "/booking"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager Nav
@inject ChopChop.Services.UIService UI

<PageTitle>Booking — ChopChop Landscaping</PageTitle>
<HeadContent>
    <link rel="canonical" href="@Nav.Uri" />
    <meta name="description" content="Book your landscaping service in minutes. Choose service, pick a date, and we’ll confirm details." />
    <meta property="og:title" content="Book with ChopChop" />
    <meta property="og:description" content="Fast, reliable lawn care and landscaping booking." />
</HeadContent>

<section class="cc-section">
    <h1>Book your visit</h1>
    <p class="cc-helper">This takes under 2 minutes.</p>

    <div class="card cc-card">
        <EditForm Model="model" OnValidSubmit="OnSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="row md-2">
                <div style="width:100%">
                    <TelerikFloatingLabel Text="Service">
                        <TelerikDropDownList id="service" Data="@ServiceOptions" TextField="Name" ValueField="Id" @bind-Value="model.ServiceId" Width="100%" />
                    </TelerikFloatingLabel>
                    <div class="cc-hint">Not sure? Pick what’s closest—we’ll confirm on the call.</div>
                    <ValidationMessage For="@(() => model.ServiceId)" />
                </div>
                <div style="width:100%">
                    <TelerikFloatingLabel Text="Preferred Date">
                        <TelerikDatePicker id="date" @bind-Value="model.Date" Width="100%" />
                    </TelerikFloatingLabel>
                    <div class="cc-hint">We’ll email to confirm a time.</div>
                    <ValidationMessage For="@(() => model.Date)" />
                </div>
            </div>
            <div class="row md-2">
                <div style="width:100%">
                    <TelerikFloatingLabel Text="Service address">
                        <TelerikTextBox id="address" @bind-Value="model.Address" Width="100%" />
                    </TelerikFloatingLabel>
                    <div class="cc-hint">Used to confirm service area.</div>
                    <ValidationMessage For="@(() => model.Address)" />
                </div>
                <div style="width:100%">
                    <TelerikFloatingLabel Text="Email">
                        <TelerikTextBox id="contact" @bind-Value="model.Contact" Width="100%" />
                    </TelerikFloatingLabel>
                    <div class="cc-hint">For confirmations and reminders.</div>
                    <ValidationMessage For="@(() => model.Contact)" />
                </div>
            </div>
            <div style="margin-top:12px; display:flex; gap:16px; align-items:center;">
                <TelerikCheckBox @bind-Value="model.AddMulch" /> <span>Add mulch</span>
                <TelerikCheckBox @bind-Value="model.AddFertilizer" /> <span>Add fertilizer</span>
            </div>
            <div style="margin-top:12px; display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
                <TelerikButton ThemeColor="Primary" ButtonType="ButtonType.Submit">Request Booking</TelerikButton>
                <TelerikButton Class="cc-ghost" OnClick="@(() => Nav.NavigateTo("/pricing"))">See Pricing</TelerikButton>
            </div>
        </EditForm>
    </div>
</section>

@code {
    class BookingModel
    {
        [Required] public string ServiceId { get; set; } = "lawn";
        [Required] public DateTime? Date { get; set; } = DateTime.Today.AddDays(1);
        [Required] public string Address { get; set; } = string.Empty;
        [Required, EmailAddress] public string Contact { get; set; } = string.Empty;
        public bool AddMulch { get; set; }
        public bool AddFertilizer { get; set; }
        public string? Plan { get; set; }
    }

    record Option(string Id, string Name);
    List<Option> ServiceOptions = new() { new("lawn","Lawn Mowing"), new("trim","Hedge Trimming"), new("garden","Garden Care") };
    BookingModel model = new();

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = ParseQuery(uri.Query);
        if (query.TryGetValue("service", out var svc))
        {
            var match = ServiceOptions.FirstOrDefault(o => string.Equals(o.Id, svc, StringComparison.OrdinalIgnoreCase));
            if (match != null) model.ServiceId = match.Id;
        }
        if (query.TryGetValue("plan", out var plan) && !string.IsNullOrWhiteSpace(plan))
        {
            model.Plan = plan;
            UI.ShowToast($"We’ll apply the {plan} plan to your quote.");
        }
    }

    private static Dictionary<string, string> ParseQuery(string query)
    {
        var dict = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        if (string.IsNullOrEmpty(query)) return dict;
        if (query.StartsWith("?")) query = query.Substring(1);
        var parts = query.Split('&', StringSplitOptions.RemoveEmptyEntries);
        foreach (var p in parts)
        {
            var kv = p.Split('=', 2);
            var key = Uri.UnescapeDataString(kv[0]);
            var value = kv.Length > 1 ? Uri.UnescapeDataString(kv[1]) : string.Empty;
            dict[key] = value;
        }
        return dict;
    }

    async Task OnSubmit()
    {
        UI.SetBusy(true);
        try
        {
            await Task.Delay(800); // simulate async
            UI.ShowToast("Thanks! We’ll confirm by email shortly.");
            Nav.NavigateTo("/contact?submitted=1", forceLoad: false);
        }
        finally
        {
            UI.SetBusy(false);
        }
    }
}
