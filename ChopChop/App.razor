@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Telerik.Blazor
@using Telerik.Blazor.Components
@inject NavigationManager Navigation

<TelerikRootComponent IconType="@IconType.Font">
  <Router AppAssembly="@typeof(Program).Assembly">
      <Found Context="routeData">
          <RouteView RouteData="@routeData" DefaultLayout="@typeof(Shared.MainLayout)" />
          <FocusOnNavigate RouteData="@routeData" Selector="h1" />
      </Found>
      <NotFound>
          <LayoutView Layout="@typeof(Shared.MainLayout)">
              <section class="cc-section">
                  <div class="cc-card" style="padding:20px">
                      <h1>Page not found</h1>
                      <p class="cc-helper">Sorry, there’s nothing at this address.</p>
                      <div class="cc-cta">
                          <TelerikButton ThemeColor="primary" OnClick='@(() => Navigation.NavigateTo("/"))'>Go Home</TelerikButton>
                          <TelerikButton ThemeColor="base" OnClick='@(() => Navigation.NavigateTo("/services"))'>See Services</TelerikButton>
                      </div>
                  </div>
              </section>
          </LayoutView>
      </NotFound>
  </Router>
</TelerikRootComponent>
