<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  <!-- Telerik private feed requires authentication. -->
  <add key="TelerikNuGetV3" value="https://nuget.telerik.com/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Microsoft.*" />
      <package pattern="System.*" />
      <!-- Allow public Telerik utility packages (Icons, Licensing) to resolve from nuget.org -->
      <package pattern="Telerik.FontIcons" />
      <package pattern="Telerik.SvgIcons" />
      <package pattern="Telerik.Licensing" />
    </packageSource>
    <packageSource key="TelerikNuGetV3">
      <!-- Private/commercial Telerik packages -->
      <package pattern="Telerik.*" />
    </packageSource>
  </packageSourceMapping>
  <!-- To add Telerik credentials locally, see: dotnet nuget add source (official docs). Example: add source https://nuget.telerik.com/v3/index.json with name telerik.com and your credentials. -->
</configuration>
